# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Audio assets (downloaded, not source) — root-level only so eval_data/*/audio/
# isn't accidentally caught by the bare pattern.
/audio/
/audio_vocals/
*.wav
*.mp3
*.m4a

# OOS eval audio — gitignore raw recordings, keep GT JSONs in test/
eval_data/*/audio/*
!eval_data/*/audio/.gitkeep
eval_data/*/review/
eval_data/*/assisted_test/
diagnostics/oos_v1_assisted_crosscheck.md
submissions/oos_v1_assisted_*/
submissions/phase2_13_lock_fusion_paired/

# Caches
.cache/
*.banidb_cache.json
.banidb_cache.json
corpus_cache/
asr_cache/
asr_cache_vocals/
mms_cache/
training_data/
lora_adapters/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code per-developer state
.claude/settings.local.json
CLAUDE.local.md

# Secrets and credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
.huggingface/
.cache/huggingface/

# Model artifacts (large, derived)
*.mlpackage/
*.mlmodelc/
*.onnx
checkpoints/
runs/
coreml_export/

# iOS — generated bundle resources (regenerated by scripts/build_ios_corpus.py)
ios/Sources/GurbaniCaptioning/Resources/shabads.json
ios/.build/
ios/.swiftpm/
ios/build_check/
ios/*.xcodeproj/xcuserdata/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/**/xcuserdata/
ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# macOS iCloud Drive conflict duplicates — pattern is `filename 2.ext`.
# The repo lives under ~/Desktop/ which iCloud syncs; two-Mac workflow
# regularly produces these stale copies. See memory/project_icloud_drive_repo.md
* 2.*
* 2/

# M5.7d — small WAV fixture used by `ModelParityTests`. `*.wav` is
# globally ignored (line 20) to keep `audio/` out of git, but this 5-second
# snippet (160 KB) is committed so the parity test runs without requiring
# the reviewer to also download `audio/IZOsmkdmmcg_16k.wav`.
!ios/Tests/GurbaniCaptioningTests/Fixtures/*.wav

# M5.7d — HF tokenizer files bundled alongside the Core ML .mlmodelc set.
# Reproducible from `huggingface-cli download surindersinghssj/surt-small-v3 ...`
# and `make ios-bundle-model`. Keep out of git for the same size + diff
# reasons as the *.mlmodelc/ rule above (~5MB of binary-ish JSON).
ios/Sources/GurbaniCaptioning/Resources/*/tokenizer.json
ios/Sources/GurbaniCaptioning/Resources/*/tokenizer_config.json
ios/Sources/GurbaniCaptioning/Resources/*/vocab.json
ios/Sources/GurbaniCaptioning/Resources/*/merges.txt
ios/Sources/GurbaniCaptioning/Resources/*/special_tokens_map.json
ios/Sources/GurbaniCaptioning/Resources/*/added_tokens.json
ios/Sources/GurbaniCaptioning/Resources/*/normalizer.json
ios/Sources/GurbaniCaptioning/Resources/*/preprocessor_config.json
ios/Sources/GurbaniCaptioning/Resources/*/generation_config.json
ios/Sources/GurbaniCaptioning/Resources/*/config.json
